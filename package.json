{
  "name": "nara-api",
  "version": "0.1.0",
  "description": "NARA backend — NestJS microservices (gateway + auth + people + ops + ai)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build auth && nest build people && nest build ops && nest build ai",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway --watch",
    "start:auth": "nest start auth --watch",
    "start:people": "nest start people --watch",
    "start:ops": "nest start ops --watch",
    "start:ai": "nest start ai --watch",
    "kill:ports": "node scripts/kill-ports.mjs",
    "start:dev:all": "npm run kill:ports && concurrently -n gateway,auth,people,ops,ai -c blue,green,yellow,magenta,cyan \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:people\" \"npm:start:ops\" \"npm:start:ai\"",
    "start:prod:gateway": "node dist/apps/gateway/apps/gateway/src/main.js",
    "start:prod:auth": "node dist/apps/auth/apps/auth/src/main.js",
    "start:prod:people": "node dist/apps/people/apps/people/src/main.js",
    "start:prod:ops": "node dist/apps/ops/apps/ops/src/main.js",
    "start:prod:ai": "node dist/apps/ai/apps/ai/src/main.js",
    "start:prod:all": "concurrently -n gateway,auth,people,ops,ai -c blue,green,yellow,magenta,cyan \"npm:start:prod:gateway\" \"npm:start:prod:auth\" \"npm:start:prod:people\" \"npm:start:prod:ops\" \"npm:start:prod:ai\"",
    "start:all": "npm run build && npm run start:prod:all",

    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "concurrently": "^9.1.2",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
