# Copiar a .env y completar. No subir secretos al repo.

PORT=4000
NARA_GATEWAY_PORT=4000
NARA_AUTH_PORT=4001
NARA_PEOPLE_PORT=4002
NARA_OPS_PORT=4003
NARA_AI_PORT=4004
NARA_MS_HOST=127.0.0.1

MONGODB_URI=mongodb+srv://USER:PASS@HOST/nara
MONGODB_DB=nara

AUTH_SECRET=cambiar-por-un-secreto-largo
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Proveedor de IA principal (si está, se usa antes que Gemini; ver libs/ai/src/llm.ts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# access_log (6.19): sal para hash de correo; alerta de muchos fallos (webhook, no TEO)
ACCESS_LOG_EMAIL_SALT=
ACCESS_ALERT_WEBHOOK=
ACCESS_ALERT_EMAIL=
ACCESS_ALERT_EMAIL_WEBHOOK=
